# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 이 파일은 Git에 포함됩니다 (비어 있는 예시만).
# 복사해서 같은 폴더에 application-secret.properties 로 저장한 뒤 값을 채우세요.
#   application-secret.properties 는 .gitignore → 커밋 안 됨
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# OpenAI (아바타 등) — 아래 한 줄만 있어도 됨 (둘 다 넣어도 됨)
OPENAI_KEY=sk-proj-여기에_키_붙여넣기
# Spring이 한쪽만 읽는 환경이면 이 줄도 추가:
# openai.api.key=sk-proj-동일한_키_붙여넣기

# Gemini (손 사진 인증)
GEMINI_KEY=여기에_제미나이_키_붙여넣기
# 또는 Spring key로 직접:
# gemini.api.key=동일한_키_붙여넣기

# (선택) 다른 서비스용 키가 있으면 아래에 추가
